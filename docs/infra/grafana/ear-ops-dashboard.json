      "description": "",
      "type": "datasource",
      "pluginId": "cloudwatch",
      "pluginName": "CloudWatch"
    },
    {
      "name": "DS_PROM",
      "label": "Prometheus (합성 모니터링 지표 — grafanacloud-<스택>-prom)",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [],
  "title": "ear 운영",
  "uid": "ear-ops",
  "tags": [
    "ear",
    "infra"
  ],
  "timezone": "Asia/Seoul",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "cloudwatch",
          "uid": "${DS_CLOUDWATCH}"
        },
        "enable": true,
        "iconColor": "red",
        "name": "CloudWatch 알람 상태 변화",
        "prefixMatching": true,
        "alarmNamePrefix": "ear-prod-",
        "actionPrefix": "",
        "region": "default"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "장애 플레이북",
      "type": "link",
      "url": "https://github.com/swm-runtime/ear_project/blob/main/docs/infra/incident-playbook.md",
      "targetBlank": true
    },
    {
      "title": "어드민 콘솔 — 백엔드 로그",
      "type": "link",
      "url": "https://admin.earcast.co.kr/backend-logs",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "헬스체크 — 프로브별 (최근 6분 최솟값)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 7,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "description": "Grafana 합성 체크 ear-api-health. 3분 간격·서울·도쿄. 한 프로브만 DOWN 이면 프로브 문제일 수 있다 — 둘 다 DOWN 이면 A001.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "min_over_time(probe_success{job=\"ear-api-health\"}[6m])",
          "legendFormat": "{{probe}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "가동률 24h",
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "avg(avg_over_time(probe_success{job=\"ear-api-health\"}[24h]))",
          "legendFormat": "24h",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "헬스체크 평균 응답시간 (프로브별, 15분 창)",
      "gridPos": {
        "x": 11,
        "y": 0,
        "w": 13,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum by (probe) (increase(probe_all_duration_seconds_sum{job=\"ear-api-health\"}[15m])) / sum by (probe) (increase(probe_all_duration_seconds_count{job=\"ear-api-health\"}[15m]))",
          "legendFormat": "{{probe}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "프로브에서 /api/v1/health 까지 왕복의 15분 평균 — 합성 체크는 기본 지표만 발행해(전체 지표 발행 끔) 게이지가 없고 _sum/_count 만 있다. 서울 프로브가 기준값(정상 0.05s 대, 도쿄 0.1s 대). 급등하면 A001/A003 보다 먼저 B006(부하) 을 의심."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU 사용률 (운영 EC2)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 7
