+  if ([container isKindOfClass:[RNSScreenStackView class]]) {
+    [(RNSScreenStackView *)container modalWasDismissedNatively:self];
+  }
+  [RNSScreen earNoteZoomDiagnostic:[NSString stringWithFormat:@"settled:%@", origin]];
+  [self.screenView notifyDismissedWithCount:1];
+}
