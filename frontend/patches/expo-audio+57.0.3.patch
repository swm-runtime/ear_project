+package expo.modules.audio
+
+import android.net.Uri
+import androidx.core.net.toUri
+import androidx.media3.datasource.DataSource
+import androidx.media3.datasource.DataSpec
+import androidx.media3.datasource.ResolvingDataSource
+import java.io.IOException
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * [ear patch] KAN-124 — 서명 URL 갱신을 음원 교체 없이 반영한다.
+ *
+ * 플레이어에는 재생 내내 바뀌지 않는 `ear-audio://<key>` 주소를 준다. 데이터 소스가 바이트 요청을 열 때마다
+ * (최초 열기 · 탐색 · 오류 뒤 재시도) [resolveDataSpec] 이 그 주소를 JS 가 마지막으로 넘긴 서명 URL 로 바꾼다.
+ * 그래서 4분마다 URL 이 갱신돼도 미디어 소스를 갈아 끼우지 않는다 — 버퍼·위치·배속이 그대로다.
+ *
+ * URL 공급이 끊기면(갱신 실패) 표의 마지막 URL 로 계속 요청한다. 그 URL 이 만료돼 403 이 나면 ExoPlayer 의
+ * 기본 재시도(매번 다시 resolve 하므로 그 사이 들어온 새 URL 을 집는다)를 거친 뒤 재생 오류로 올라간다.
+ */
+@androidx.annotation.OptIn(androidx.media3.common.util.UnstableApi::class)
+object EarAudioStream : ResolvingDataSource.Resolver {
+  const val SCHEME = "ear-audio"
+
+  private val urls = ConcurrentHashMap<String, String>()
+
+  private fun keyOf(uri: Uri): String? {
+    if (uri.scheme != SCHEME) {
+      return null
+    }
+    return uri.host?.lowercase()?.takeIf { it.isNotEmpty() }
+  }
+
+  fun setUrl(streamUri: String, url: String) {
+    val key = keyOf(streamUri.toUri()) ?: return
+    urls[key] = url
+  }
+
+  fun clearUrl(streamUri: String) {
+    val key = keyOf(streamUri.toUri()) ?: return
+    urls.remove(key)
+  }
+
+  fun factory(upstream: DataSource.Factory): DataSource.Factory =
+    ResolvingDataSource.Factory(upstream, this)
+
+  @Throws(IOException::class)
+  override fun resolveDataSpec(dataSpec: DataSpec): DataSpec {
+    val key = keyOf(dataSpec.uri) ?: return dataSpec
+    val url = urls[key] ?: throw IOException("ear-audio: no signed url registered for $key")
+    return dataSpec.withUri(url.toUri())
+  }
+}
