{
  "expo": {
    "name": "frontend",
    "slug": "ear",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ear",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.runtime.ear",
      "appleTeamId": "3RJ4N5XLN9",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:earcast.co.kr"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.runtime.ear",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "earcast.co.kr",
              "pathPrefix": "/contents"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.475643832949-gl9ntr62dssgt0ovg8t6ibe9alo2jdt0"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "e1f65f8291691ef43de3164b0a602604",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "handleKakaoOpenUrl": true
          }
        }
      ],
      [
        "@react-native-seoul/naver-login",
        {
          "urlScheme": "earnaverlogin"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "socialAuth": {
        "googleWebClientId": "475643832949-q10v2jk03pjh0f37vurot61c216snist.apps.googleusercontent.com",
        "googleIosClientId": "475643832949-gl9ntr62dssgt0ovg8t6ibe9alo2jdt0.apps.googleusercontent.com",
        "kakaoNativeAppKey": "e1f65f8291691ef43de3164b0a602604",
        "appleServicesId": "com.runtime.ear.signin",
        "appleRedirectUri": "https://earcast.co.kr/auth/apple/callback",
        "naverAppName": "이어",
        "naverConsumerKey": "I9icgB6gL7MoJesrFqE3",
        "naverConsumerSecret": "1ChePp2q8M",
        "naverServiceUrlScheme": "earnaverlogin"
      },
      "eas": {
        "projectId": "affd5e83-2719-469a-8c5c-f12b09e7ba4a"
      }
    },
    "owner": "runtime364"
  }
}
