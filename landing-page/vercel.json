{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "rewrites": [
    {
      "source": "/auth/apple/callback",
      "destination": "/api/apple-callback"
    },
    {
      "source": "/auth/apple/callback/",
      "destination": "/api/apple-callback"
    },
    {
      "source": "/contents/:id",
      "destination": "/contents/"
    },
    {
      "source": "/contents/:id/",
      "destination": "/contents/"
    },
    {
      "source": "/google5f4450f5b72351d0.html",
      "destination": "/google5f4450f5b72351d0/"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
