# 이 파일은 템플릿이다. 실값을 적지 않는다 (backend/.env.example과 같은 규칙)

# 내부 호출 인증 — 호출자(메타데이터 부여 스킬·Backend)와 공유. 누락 시 기동 실패
INTERNAL_AUTH_TOKEN=change-me

# 임베딩 모델 — OpenAI text-embedding-3-small · 1536차원 확정 (2026-09-01, docs/backend/domain.md 15.1 #11)
# 키가 없는 로컬 검증은 EMBEDDING_PROVIDER=stub 으로 바꿔 띄운다 (결정적 더미 벡터 — 운영 저장 금지)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=change-me

# 청킹 문자 한도 (기본 4000)
#EMBEDDING_CHUNK_CHARS=4000
