# Supabase (Settings → API). publishable/anon 키는 RLS 뒤에서만 동작하므로 브라우저 노출 가능.
NEXT_PUBLIC_SUPABASE_URL=https://akckswokvlosgmzawjuq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# (선택) 이관 전 local: 키가 남아 있을 때만 — 그 키를 읽는 작업 루트. 정규 키(s3:)는 아래 S3 설정으로 읽는다
WORK_ROOT=

# ── 산출물 저장소: 파이프라인 S3 (spec/10 3.3) — 서버 전용, 브라우저에 노출되지 않는다 ──
PIPELINE_BUCKET=earcast-pipeline-prod
AWS_REGION=ap-northeast-2
# AWS_PROFILE=isb              # 로컬 개발(임대 보유자 SSO). EC2 에서는 인스턴스 역할 — 비움
# /api/storage (로컬 워커용 서명 URL 라우트) 인증 토큰 — 생성: openssl rand -hex 32. 워커 .env 의 PIPELINE_WORKER_TOKEN 과 같은 값
PIPELINE_WORKER_TOKEN=

# ── 제품 발행 (/publish — admin 콘솔 병합) ──
# 제품 API. 프록시(/api/ear)가 서버에서 부른다 — CORS 무관
EAR_API_BASE_URL=https://api.earcast.co.kr/api/v1
# 제품 로그인용 구글 웹 클라이언트 ID (비밀 아님). GCP "승인된 JavaScript 원본"에 이 웹의 오리진 등록 필요
NEXT_PUBLIC_EAR_GOOGLE_CLIENT_ID=475643832949-q10v2jk03pjh0f37vurot61c216snist.apps.googleusercontent.com
