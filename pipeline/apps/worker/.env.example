# Supabase Postgres 직결 (pooler, 세션 모드). 비밀번호는 팀 비밀 채널로 — 저장소 커밋 금지.
DATABASE_URL=postgresql://postgres.akckswokvlosgmzawjuq:<PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 워커 식별 (runs.executed_by · jobs.claimed_by 에 기록). 비우면 <계정>@<호스트명>
WORKER_NAME=

# 실행기: claude-cli (로컬, 본인 Claude Code 구독) | api (ANTHROPIC_API_KEY 필요, 서버) | none (AI 작업 안 집음)
EXECUTOR=claude-cli
# 워커가 집을 작업 종류: ai,io (로컬) | io (서버)
CAPABILITIES=ai,io
# claude-cli 실행기 모델 (비우면 계정 기본 모델). 예: claude-opus-5
CLAUDE_MODEL=
# 비평 전용 모델 (기본 claude-opus-5 — 비평은 Opus 고정, 2026-09-01). 바꾸면 회귀 세트 재검증 대상
CRITIC_MODEL=claude-opus-5

# 자산 원본 루트 — spec/03·04·05 와 시딩 원본(npm run assets:import). 비우면 레포의 docs/ai.
# 규칙 자산 7개(guidelines·골드·QA 프롬프트·루브릭)의 진실은 DB prompt_assets 이며 워커가 작업 시작 시 읽어 WORK_ROOT/assets/<해시>/ 에 내려놓는다 (spec/10 3.2)
ASSET_ROOT=
# 산출물 작업 루트 — S3 의 로컬 캐시 (episodes/·sweeps/·assets/). claude -p 의 cwd. 비우면 pipeline/.work (gitignore). 지워도 다음 단계가 다시 내려받는다.
# 레포 안 경로는 쓰지 않는다 (루트 CLAUDE.md 가 생성 컨텍스트에 섞임)
WORK_ROOT=

# ── 산출물 저장소: 파이프라인 S3 (spec/10 3.3 · spec/08 2장) — 원본은 S3, WORK_ROOT 는 캐시 ──
# S3_MODE: direct = AWS SDK 직접 (EC2 인스턴스 역할, 개발 중엔 AWS_PROFILE) · web = 웹 /api/storage 서명 URL (팀원 노트북 기본 — AWS 키 없음)
#          비우면 PIPELINE_WEB_URL 이 있을 때 web, 없으면 direct
S3_MODE=
# direct 모드
PIPELINE_BUCKET=earcast-pipeline-prod
AWS_REGION=ap-northeast-2
# AWS_PROFILE=isb              # 개발용(임대 보유자 SSO 프로필). 액세스 키를 노트북에 두지 않는다 — 서버는 인스턴스 역할이라 비움
# web 모드 (노트북) — 웹의 PIPELINE_WORKER_TOKEN 과 같은 값 (팀 비밀 채널)
PIPELINE_WEB_URL=              # 예: https://admin.earcast.co.kr (로컬 개발: http://localhost:3000)
PIPELINE_WORKER_TOKEN=

# (선택) 백엔드 ERROR → Slack 알림 — 서버 워커에만 켠다. 로컬은 비워 둔다
#SLACK_ERROR_WEBHOOK_URL=
