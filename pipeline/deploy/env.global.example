# 글로벌판 인스턴스 env (KAN-208 · docs/ai/global/PIPELINE.md 4.2·8장) — 서버 deploy/env.global 에 실값, 커밋 금지.
# web-global·worker-global 이 env_file 로 읽는다. 한국판과 공유하는 값(OPENAI·ElevenLabs 키, 발행 SSO, AI 서버 토큰)은 env.prod 에서 compose 가 채운다 — 여기 적지 않는다.
# 이 파일이 비어 있으면 push.sh 가 글로벌 서비스를 띄우지 않는다(한국판만).

# 글로벌 Supabase — 워커는 Session pooler(IPv4, 5432) 연결 문자열. Direct(db.<ref>.supabase.co)는 IPv6 전용이라 EC2 에서 안 붙는다
DATABASE_URL=
# 콘솔 — 실행 시점에 읽는다(이미지는 한국판과 같다). anon 키는 공개 값
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 글로벌 산출물 버킷 (setup-pipeline-bucket.sh 로 생성 · 정책 ear-pipeline-global-bucket-rw 를 ear-ai-ec2 역할에 부착)
PIPELINE_BUCKET=earcast-pipeline-global
# 진행자 이름 "해설,진행" — 페르소나 확정 전에는 임시 이름(대본이 아직 돌지 않는다)
PIPELINE_SPEAKERS=
# 영어 보이스 — 비어 있으면 TTS 를 멈춘다(보이스 결정 대기)
TTS_VOICE_A=
TTS_VOICE_B=
# 알림 링크·워커용 서명 URL 토큰(글로벌판은 노트북 워커가 없지만 콘솔이 값을 요구한다 — 한국판과 다른 임의 값)
PIPELINE_CONSOLE_URL=https://admin-global.earcast.co.kr
PIPELINE_WORKER_TOKEN=
