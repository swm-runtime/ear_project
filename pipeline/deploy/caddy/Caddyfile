# AI 서버의 공개 진입점은 파이프라인 웹 하나다 — 도메인은 admin.<도메인> (2026-09-03 admin 콘솔 통합, spec/10 2장의 pipeline.<도메인> 표기는 개정 대상).
# TLS 는 Let's Encrypt 자동 발급 — A 레코드가 이 서버를 가리키고 80/443 이 열려 있으면 끝.
# ai-server(:8000)는 여기로 프록시하지 않는다 — 제품 서버가 VPC 사설 IP 로, 노트북은 SSH 터널로 부른다.
{$PIPELINE_DOMAIN} {
	encode gzip

	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format console
	}
}

# 글로벌판 콘솔 (KAN-208) — web-global 은 서버에 deploy/env.global 이 있을 때만 뜬다. 뜨기 전에는 이 주소가 502.
# A 레코드(admin-global)를 먼저 걸어야 한다 — 레코드 전에 발급을 시도하면 Caddy 가 최대 20분 물러난다(deploy/README 함정).
{$PIPELINE_GLOBAL_DOMAIN:admin-global.earcast.co.kr} {
	encode gzip

	reverse_proxy web-global:3000 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format console
	}
}
