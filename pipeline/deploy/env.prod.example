# AI 서버 compose 값 — 서버의 /opt/ear/ear_project/pipeline/deploy/env.prod 로 복사해 채운다. 커밋 금지(gitignore).
# 파일명에 점을 붙이지 않는 이유: .env* 는 dockerignore·저장소 편집 도구의 차단 대상이라 배포용은 이름을 분리했다.
# 랜덤 비밀은 openssl rand -hex 32 로, 값마다 다르게.

PIPELINE_DOMAIN=admin.earcast.co.kr

# Supabase (웹 빌드에 박힘 — anon 키는 RLS 뒤라 브라우저 노출 가능 값. 팀 비밀 채널)
NEXT_PUBLIC_SUPABASE_URL=https://akckswokvlosgmzawjuq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# 워커(IO) DB 직결 — 비밀번호는 팀 비밀 채널
DATABASE_URL=postgresql://postgres.akckswokvlosgmzawjuq:<PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 산출물 S3 (spec/10 3.3) — 자격증명은 인스턴스 역할 ear-ai-ec2, 여기에 AWS 키를 두지 않는다
PIPELINE_BUCKET=earcast-pipeline-prod
AWS_REGION=ap-northeast-2

# /api/storage 워커 인증 토큰 — 팀원 노트북 워커의 PIPELINE_WORKER_TOKEN 과 같은 값
PIPELINE_WORKER_TOKEN=

# TTS — ElevenLabs (spec/06). 키는 connect 절차로 서버 env.prod 에만. 보이스 ID 는 코드 기본값(config.ts) — 바꾸면 리브랜딩급
ELEVENLABS_API_KEY=

# ── 제품 발행 콘솔 (/publish — admin 병합, PR #86) ──
# 구글 웹 클라이언트 ID (비밀 아님 — 웹 빌드에 박힘). GCP "승인된 JavaScript 원본"에 https://admin.earcast.co.kr 등록 필요
# 제품 SSO 어서션 서명 키 — 제품 서버 .env의 PIPELINE_SSO_SECRET과 같은 값 (openssl rand -hex 32)
EAR_SSO_SECRET=
# 제품 API 베이스 (서버 프록시 /api/ear 가 호출) — 기본값과 같으면 생략 가능
EAR_API_BASE_URL=https://api.earcast.co.kr/api/v1

# 배포 시점의 git 리비전 — deploy/README.md 5장(재배포)이 채운다 (runs.worker_rev 기록용)
WORKER_REV=

# 백엔드 로그 화면(/backend-logs) — CloudWatch 로그 그룹. 기본값이 백엔드 compose와 맞으므로
# 보통 비워 둔다 (backend/docker-compose.prod.yml의 awslogs-group을 바꿨을 때만 지정)
#BACKEND_LOG_GROUP_API=/ear/api
#BACKEND_LOG_GROUP_CADDY=/ear/caddy

# 백엔드 ERROR → Slack 알림 (worker log-watch). Slack 앱 → Incoming Webhooks 에서 발급.
# 비우면 기능이 꺼진다 — 실값은 서버 env.prod 에만 (커밋 금지)
SLACK_ERROR_WEBHOOK_URL=
