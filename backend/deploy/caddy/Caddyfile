# TLS는 Let's Encrypt로 자동 발급된다. API_DOMAIN의 A 레코드가 이 서버를 가리키고
# 80/443이 보안그룹에서 열려 있으면 그걸로 끝이다.
{$API_DOMAIN} {
	encode gzip

	# 오디오는 여기로 오지 않는다 — CloudFront가 나른다. 혹시 local 모드로 되돌리면
	# /api/v1/audio/* 도 그대로 api로 흐른다(별도 설정 없음).
	reverse_proxy api:3000 {
		header_up X-Forwarded-Proto {scheme}
	}

	# 쿼리의 이메일·서명은 가린다 — Nest 로그는 redact-url.util 이 가리지만 이 접근 로그는 uri 를 쿼리째
	# CloudWatch(/ear/caddy)로 보낸다(관리자 편성 미리보기 `?email=` — 2026-10-13 보안 점검). 헤더의
	# Authorization·Cookie 는 Caddy 가 기본으로 가린다
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					replace email REDACTED
					replace signature REDACTED
				}
			}
		}
	}
}

# 관리자 웹 콘솔(admin.md) — 정적 파일 한 장. API는 위 도메인으로 CORS 호출한다.
# ADMIN_DOMAIN이 비어 있으면 이 블록은 무시된다(Caddy는 빈 호스트를 매칭하지 않는다).
{$ADMIN_DOMAIN} {
	root * /srv/admin
	file_server
	header {
		Cache-Control "no-store"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}
	log {
		output stdout
		format console
	}
}
