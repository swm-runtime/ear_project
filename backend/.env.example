# 이 파일은 **템플릿이다. 실값을 적지 않는다.**
# 공개 저장소이므로, 여기에 실값을 적는 습관이 생기면 언젠가 진짜 비밀이 올라간다.
# 각 항목의 실값을 어디서 구하는지는 주석에 적어두고, 값 자체는 배포 시크릿 매니저에만 둔다.
#
# architecture.md 9.5 — 모든 비밀값은 환경 변수로 주입한다. .env는 커밋하지 않는다.
# 이 파일을 .env로 복사해 로컬 값을 채운다.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=ear
DB_PASSWORD=change-me
DB_NAME=runtime

# 쉼표로 구분한 허용 오리진 목록. `*`를 쓰지 않는다.
# 앱(Expo) 외에 랜딩 페이지(landing-page/)도 브라우저에서 직접 부른다 — GET /public/sample.
# 운영은 https://earcast.co.kr 을, 로컬은 랜딩 dev 서버(http://localhost:3000 등)를 더한다
CORS_ORIGINS=http://localhost:8081

# 서명 키·pepper — 32자 이상. 운영 값은 시크릿 매니저에서 주입한다(domain.md 11.2, architecture.md 9.5).
# ARCHIVE_HASH_PEPPER와 WITHDRAWAL_HASH_PEPPER는 반드시 서로 다른 값이어야 한다.
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
ARCHIVE_HASH_PEPPER=local-dev-archive-pepper-change-me-0123456789
WITHDRAWAL_HASH_PEPPER=local-dev-withdrawal-pepper-change-me-0123456789

# 애플 로그인 — identity token의 aud로 실려 오는 iOS 앱 Bundle ID다(auth-api.md 4.1).
# 비밀값은 아니지만 검증에 반드시 필요하다. 확인하지 않으면 다른 앱을 향해 발급된,
# 서명은 정상인 토큰으로 우리 계정에 로그인할 수 있다.
# 애플은 제공자 API 호출 없이 토큰만으로 검증이 끝나므로 aud가 사실상 유일한 판정 근거다.
APPLE_CLIENT_ID=com.example.ear

# 안드로이드 애플 로그인(웹 OAuth)의 aud — Services ID다. 안드로이드에는 애플 네이티브
# SDK가 없어 웹 OAuth로 가며, 그때 identity token의 aud는 번들 ID가 아니라 이 값이다.
# 두 값을 모두 유효한 aud로 받아야 iOS 네이티브와 안드로이드 웹이 한 엔드포인트를 쓴다.
APPLE_SERVICES_ID=com.example.ear.signin

# 구글 로그인 — ID 토큰의 aud로 실려 오는 웹 클라이언트 ID다(auth-api.md 4.1).
# 안드로이드/iOS 클라이언트 ID가 아니다. 클라이언트가 액세스 토큰이 아니라 ID 토큰을 보내므로
# 서버는 제공자 API 왕복 없이 서명과 aud만으로 검증한다 — aud가 유일한 "우리 앱을 향한
# 토큰인가" 판정 근거다.
# 실값: Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > 웹 애플리케이션 클라이언트 ID
GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# 카카오 로그인 — 토큰 정보 조회의 app_id와 대조할 앱 ID(숫자)다. 네이티브 앱 키가 아니다.
# 카카오 액세스 토큰에는 대상 앱 정보가 실려 있지 않아, 이 대조가 없으면 다른 카카오 앱에서
# 발급된 정상 토큰으로도 우리 계정에 로그인할 수 있다(auth-api.md 4.1).
# 실값: Kakao Developers > 내 애플리케이션 > 앱 설정 > 요약 정보 > 앱 ID
KAKAO_APP_ID=0000000

# 앱 버전 — 테이블이 아니라 배포 설정이 원천이다(settings-api.md 4.1, domain.md 13.3).
# LATEST_APP_VERSION_*: 스토어 최신 버전. 설정 화면의 [업데이트] 배지 판정에 쓴다.
# MIN_SUPPORTED_APP_VERSION_*: 최소 지원 버전. 강제 업데이트 판정은 스플래시 소관이다.
#
# 플랫폼별로 나눈다 — 스토어 심사 주기가 달라 두 값이 동시에 올라가지 않는다.
# 한쪽만 배포된 동안에는 그쪽 값만 올린다. 둘을 함께 올리면 아직 심사 중인 플랫폼의
# 사용자에게 받을 것이 없는 [업데이트]가 뜨고, 최소 지원까지 올리면 그 사용자가 갇힌다.
LATEST_APP_VERSION_IOS=1.0.0
LATEST_APP_VERSION_ANDROID=1.0.0
MIN_SUPPORTED_APP_VERSION_IOS=1.0.0
MIN_SUPPORTED_APP_VERSION_ANDROID=1.0.0

# 오디오 서명 URL — architecture.md 9.4. 우리 서버가 서명하고 우리 서버가 검증한다.
# AUDIO_URL_SIGNING_KEY: 32자 이상. JWT_SECRET과 반드시 다른 값이어야 한다.
# AUDIO_URL_BASE_URL: 서명 URL이 가리키는 스트리밍 경로. 오브젝트 스토리지 확정 시 CDN 도메인으로 바뀐다.
AUDIO_URL_SIGNING_KEY=local-dev-audio-signing-key-change-me-0123456789
AUDIO_URL_BASE_URL=http://localhost:3000/api/v1/audio
# AUDIO_STORAGE_ROOT: 오디오 원본 디렉터리. contents.audio_path가 이 아래의 상대 키다.
AUDIO_STORAGE_ROOT=./storage/audio

# 오디오 전달 방식 — local(기본) | cloudfront
# cloudfront면 AUDIO_URL_BASE_URL을 CloudFront 도메인(예: https://dxxxx.cloudfront.net/audio)으로
# 바꾸고 아래 두 값을 채운다. AUDIO_STORAGE_ROOT는 무시된다. 만드는 법: deploy/aws/README.md
AUDIO_DELIVERY=local
# CLOUDFRONT_KEY_PAIR_ID=K2JCJMDEHXQW5F
# CLOUDFRONT_PRIVATE_KEY_BASE64=<base64 -w0 private_key.pem>
# 관리자 업로드(admin.md 4.2)가 쓰는 S3 버킷 — cloudfront 모드에서 필수.
# 자격증명은 env에 두지 않는다(EC2 인스턴스 롤). 값은 deploy/aws/setup-audio-cdn.sh 출력.
# AWS_REGION=ap-northeast-2
# AUDIO_BUCKET=earcast-audio-prod

# 이메일 인증 코드 발송 — logging(기본, 발송 안 함) | ses
# ses면 MAIL_FROM_ADDRESS(SES 검증된 발신 주소)와 AWS_REGION이 필수다.
MAIL_DELIVERY=logging
# MAIL_FROM_ADDRESS=이어 <no-reply@example.com>

# 신뢰하는 리버스 프록시(LB) 홉 수 — 기본 0(끔). LB 뒤에 배포할 때만 홉 수만큼 올린다.
# 프록시가 없는데 켜면 X-Forwarded-For로 IP를 위조할 수 있다 — 켜는 쪽이 더 위험하다.
TRUST_PROXY_HOPS=0

# 운영 전용 — docker-compose.prod.yml / deploy/*.sh 가 읽는다. 개발 서버는 무시한다
# API_DOMAIN=api.example.com
# ADMIN_DOMAIN=admin.example.com     # 관리자 웹 콘솔(deploy/admin). CORS_ORIGINS에도 넣는다
# BACKUP_BUCKET=earcast-backup-prod

# 파이프라인 웹 SSO — /auth/pipeline-login 어서션 검증 키(HS256, 32자 이상).
# 파이프라인 웹 서버 env의 EAR_SSO_SECRET과 같은 값이어야 한다. 비우면 엔드포인트 비활성.
# 생성: openssl rand -hex 32 (JWT_SECRET과 다른 값!)
PIPELINE_SSO_SECRET=

# 자원 임계(CPU 70%/메모리 80%) Slack 알림 — 비우면 꺼짐. 운영 .env.prod 에만 실값
SLACK_ERROR_WEBHOOK_URL=
# Sentry 레거시 웹훅 → Slack 릴레이 토큰(선택, 2026-10-07). 비우면 POST /webhooks/sentry/:token 이 전부 404.
# 16~128자 영숫자·-·_ . Sentry Developer Settings → Internal Integration(Alert Rule Action) 의 Webhook URL 에 https://<api>/api/v1/webhooks/sentry/<값> 등록.
# 예: openssl rand -hex 24
SENTRY_WEBHOOK_TOKEN=
# Sentry Internal Integration 의 Client Secret(선택, 2026-10-07) — 웹훅 서명(Sentry-Hook-Signature) 검증. 있으면 토큰 없는
# 주소 POST /webhooks/sentry 로 받는다(권장 — 경로 토큰은 요청 로그에 남는다). 둘 다 있으면 어느 하나가 맞으면 받는다.
SENTRY_WEBHOOK_SECRET=
# 같은 Internal Integration 의 API 토큰(선택, 2026-10-07 — 권한 Issue & Event: Read). 있으면 중계 문구에 State·First Seen·건수를 붙인다.
SENTRY_API_TOKEN=

# Sentry — 비우면 초기화 자체를 안 한다(로컬·테스트 기본). 운영/개발계 .env 에만 실값.
# DSN 은 준공개 값이지만 환경별로 프로젝트가 갈리므로 커밋하지 않는다.
SENTRY_DSN=
# 환경 이름. 비우면 NODE_ENV. 운영 production / 개발계 development 로 갈라 둔다
SENTRY_ENVIRONMENT=

# 추천 테스트 콘솔(admin 웹 "추천 테스트" 탭)이 대신 행동하는 테스트 계정 이메일 — 개발계 전용.
# 비우면 그 엔드포인트가 409 로 꺼진다. 환경(SENTRY_ENVIRONMENT, 비우면 NODE_ENV)이 development 일 때만 켜진다(실제 신호를 쓰는 도구라서 — 실패 시 닫힘).
RECOMMEND_TEST_EMAIL=

# 행동 기반 자동 확장(drip-scheduling 4.5) 서버 스위치 — true 를 명시했을 때만 켜진다(2026-10-14. 비우면 어느 환경이든 꺼짐).
# 개발계는 true 로 켜 둔다. 운영은 앱이 "자동 추가됨" 배지·N/3 집계·토글(KAN-181)을 전원에게 내보낸 뒤 true 로 켠다.
AUTO_EXPAND_ENABLED=

# 글로벌 가입(global-api 2.1) — true 일 때만 English 선택 가입을 GLOBAL 로 판정한다. 비우면 닫힘 = 전원 kr.
# GLOBAL 카탈로그(주제 노출·콘텐츠)가 준비된 뒤 글로벌 출시 때 켠다. 개발계는 GLOBAL 흐름을 시험하려면 true.
GLOBAL_SIGNUP_ENABLED=

# 가입 뒤 시장 전환(global-api 4.11 — KAN-227) — true 일 때만 설정의 콘텐츠 언어 전환 API 가 열린다. 비우면 닫힘(409 MARKET_UNAVAILABLE).
# 개발계는 시험하려면 true. 운영은 앱의 설정 › 콘텐츠 언어 화면이 나간 뒤 켠다. GLOBAL 로의 전환은 GLOBAL_SIGNUP_ENABLED 도 따른다.
MARKET_CHANGE_ENABLED=

# 탐색 시리즈 카드(KAN-134 확정 설계 4번) — true 일 때만 탐색 목록이 type: content|series 항목을 섞고 같은 시리즈 편을 카드 하나로 접는다.
# 비우면 꺼짐 = 편마다 한 줄(1.2.x 호환). 운영은 앱 1.3.0 출시 → dev→main → 최소 지원 1.3.0 → true 순서로 켠다. 개발계는 FE KAN-225 준비 뒤.
SERIES_EXPLORE_CARDS_ENABLED=

# 드립 시간대 그룹(global-api 2.4, KAN-191) — true 일 때만 GLOBAL 사용자를 southeast_asia·europe·americas 그룹으로 나눠 현지 05:00 편성·07:00 알림.
# 비우면 꺼짐 = 전원 05:00 KST 편성·07:00 KST 알림(종전 그대로).
DRIP_TIMEZONE_GROUPS_ENABLED=

# 첫 드립 무작위(KAN-291 단기 실험 ⑥) — true 일 때만 온보딩 첫 드립을 관심 주제 안에서 무작위로 고른다(주제를 돌아가며, 시리즈는 1편만).
# 비우면 꺼짐 = 종전 콜드스타트 스코어링. 정규 편성(2일차 이후)은 바뀌지 않는다.
FIRST_DRIP_RANDOM_ENABLED=

# 드립 도착 알림 시각 A/B(KAN-289 단기 실험 ③-1) — true 일 때만 전 사용자를 사용자 id 해시로 나눠 A 07:30 · B 08:00(그룹 현지)에 보낸다.
# 기록 종류는 drip_arrival.a / drip_arrival.b(앱 data.type 은 drip_arrival 그대로). 비우면 꺼짐 = 전원 07:00(종전 그대로).
DRIP_ARRIVAL_AB_ENABLED=

# 시리즈 유료화(KAN-290 단기 실험 ⑤) — true 일 때만 시리즈의 무료 편수 뒤 편(기본 4편부터)을 유료 요금제(데일리·프로, 초대 코드 Pro 포함)·체험 중이 아닌
# 사용자에게 잠근다(응답 is_locked = true · 재생 403 SERIES_EPISODE_LOCKED · 드립·리텐션 알림에서 제외). 비우면 꺼짐 = 종전 그대로.
# 무료 편수는 1~99, 비우면 3.
SERIES_PAYWALL_ENABLED=
SERIES_FREE_EPISODES=

# 요금제 할인 표시(KAN-286 단기 실험 ① 가격 인하) — true 일 때만 GET /plans 유료 요금제에 정가·is_discounted 를 실어
# 앱이 정가 취소선 + "지금 할인 중"을 그린다. 끄면 앱 배포 없이 사라진다. 정가는 양의 정수(원), 비우면 그 티어는 표시 안 함.
# 정가가 plans.price_krw 이하이면 할인이 아니다. 실험 값: daily 3900 · pro 9900.
# 기간 한정 할인(11월 한 달) — PLAN_DISCOUNT_ENDS_AT(ISO 8601 + 오프셋) 이후에는 스위치와 무관하게 할인 표시를 끈다. 실험 값: 2026-12-01T00:00:00+09:00.
PLAN_DISCOUNT_DISPLAY_ENABLED=
PLAN_DISCOUNT_ORIGINAL_PRICE_DAILY_KRW=
PLAN_DISCOUNT_ORIGINAL_PRICE_PRO_KRW=
PLAN_DISCOUNT_ENDS_AT=

# 짧은 판 코호트(KAN-298 단기 실험 ④) — 이 시각(ISO 8601 + 오프셋, 예 2026-11-05T10:00:00+09:00) 이후 가입한 사용자에게는
# 짧은 판(length_profile=short)만, 그 전 가입자에게는 기존 편(standard)만 드립·탐색·검색·추천·시리즈 목록에 노출한다.
# 비우면 전원 standard(롤백 스위치 — 짧은 판은 아무에게도 안 나간다). 운영은 새 앱의 스토어 배포 시각을 넣는다. 날짜만은 거부된다.
SHORT_CONTENT_COHORT_SINCE=

# 콘텐츠 후기(content-review-api 2.1, KAN-279) — true 일 때만 후기 저장·먼저 묻기가 열린다(응답의 enabled=true).
# 비우면 꺼짐 = 저장 409 CONTENT_REVIEW_DISABLED · 먼저 묻기 show=false. 운영은 개인정보 처리방침 시행일(KAN-285) 뒤에 켠다.
CONTENT_REVIEW_ENABLED=

# 후기 참여 프로모션 발급(content-review-api 2.1, KAN-279) — true 일 때만 끝까지 들은 편 3개 · 글 10자 후기에 Pro 7일 프로모션을 1회 발급한다.
# 비우면 꺼짐 = 새 발급만 멈춘다(reward_progress=null). 가진 프로모션은 기한까지 쓸 수 있다. 운영 · 개발계 Secrets 에 true 로 상시 둔다.
CONTENT_REVIEW_REWARD_ENABLED=

# 저녁 리텐션 알림(notification 4.6, KAN-272) — off(기본·빈 값) · dry_run(보내지 않고 규칙별 건수·예시를 API 로그에) · on.
# 대상은 마케팅 수신 동의자, 그룹 현지 18:00. 운영은 dry_run 으로 며칠 숫자를 본 뒤 on.
RETENTION_PUSH_MODE=
# 아침 알림(KAN-288 단기 실험 ③) — off(기본·빈 값) · dry_run(시험 대상에게만 보내고 사유별 건수·예시를 API 로그에) · on.
# 드립이 없는 날 그룹 현지 08:00(도착 알림 크론 안)에 마케팅 동의자에게 "안 들은 콘텐츠"를 알린다. 저녁 RETENTION_PUSH_MODE 와 따로 켠다.
RETENTION_MORNING_PUSH_MODE=
# 리텐션 알림 시험 대상 — 쉼표로 구분한 사용자 id. RETENTION_PUSH_MODE=dry_run 일 때 이 사용자에게만 실제로 보낸다(규칙·빈도 제한은 그대로).
RETENTION_PUSH_TEST_USER_IDS=

# 가입 체험(subscription 4.8) — true 일 때만 새로 가입하는 계정에 체험(무제한 청취)을 준다. 비우거나 false = 안 준다.
# 꺼도 이미 받은 체험은 종료 날짜까지 유지된다(가입 때 안내한 날짜가 약속). 일수는 1~30, 비우면 7(가입한 서비스 날짜가 1일째).
SIGNUP_TRIAL_ENABLED=
SIGNUP_TRIAL_DAYS=
# 체험 도입 전에 가입한 계정에게 한 번 주는 체험의 경계(YYYY-MM-DD 서비스 날짜). 이 날짜보다 먼저 가입했고 체험을
# 받은 적 없는 계정은 위 스위치가 켜져 있는 동안 앱을 여는 날 체험을 받는다. 비우면 기존 가입자에게는 안 준다.
# 스위치를 켜는 날의 다음 날짜를 넣는다(늦는 것은 해가 없고, 이르면 그 사이 가입자가 못 받는다).
SIGNUP_TRIAL_EXISTING_USERS_BEFORE=
# 서비스 날짜 경계를 04:00 → 05:00 KST 로 옮기는 시각(ISO 8601, 예 2026-10-14T05:00:00+09:00 — domain.md 1.2, KAN-149).
# 이 시각 전은 04:00 경계, 이 시각부터 05:00 경계. 비우면 04:00 그대로. KST 05:00 정각 권장, 04:00~04:59 는 거부된다.
# 넣기 전에 약관 개정(KAN-148)이 끝나야 하고, 전환일에 기존 trial_ends_at 을 +1시간 옮긴다(runbook 4장).
SERVICE_DAY_BOUNDARY_05_FROM=
# 성능 추적 표본 비율 0~1. 비우거나 0 = 계측 미등록(기본). 0 초과는 express·nest·pg 계측을 전부 켜
# t4g.small 에서 CPU 를 50~80% 더 쓴다(2026-09-23 실측) — 개발계에서만 잠깐 올린다. 운영은 비운다
#SENTRY_TRACES_SAMPLE_RATE=

# 푸시 발송(notification.md 4.3 — Expo Push). 기본 log = 보내지 않고 로그만. 운영만 expo
PUSH_DELIVERY=log
# EAS "Enhanced security for push notifications"를 켰을 때만 필요. 운영 비밀값에만 실값
EXPO_ACCESS_TOKEN=

# 랜딩 페이지 Try 섹션이 로그인 없이 들려주는 샘플 콘텐츠 id(public-api.md 2.2). 비우면 /public/sample 이 404
# PUBLIC_SAMPLE_CONTENT_ID=

# App Store 인앱 결제 검증(subscription-api.md 7장). BUNDLE_ID·ENVIRONMENTS 가 비면 iOS 결제가 꺼진다.
# ENVIRONMENTS: 개발계 Sandbox · 운영 Production · 심사/TestFlight 결제까지 받으려면 Production,Sandbox
APP_STORE_BUNDLE_ID=
APP_STORE_APP_APPLE_ID=
APP_STORE_ENVIRONMENTS=
# App Store Server API 키 — 만료 보정(스토어에 현재 상태 조회)에만 쓴다. 비면 보정이 꺼진다. 개인키(.p8)는 base64
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY_BASE64=
# App Store Connect API 팀 키(KAN-133 스토어 리뷰 → Slack). 결제용 In-App Purchase 키와 다른 키다.
# 셋 다 있고 APP_STORE_APP_APPLE_ID 가 있어야 App Store 리뷰 폴링이 켜진다. 개인키(.p8)는 base64.
# Play 리뷰 폴링은 아래 GOOGLE_PLAY_PACKAGE_NAME · GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64 를 그대로 쓴다(Play Console 에서 리뷰 권한 추가)
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_PRIVATE_KEY_BASE64=

# Google Play 인앱 결제 검증(subscription-api.md 4.7). PACKAGE_NAME·SERVICE_ACCOUNT 가 비면 Android 결제가 꺼진다.
# 서비스 계정 JSON 키는 base64. PUBSUB_* 는 실시간 알림(RTDN) push 의 OIDC 검증값 — 비면 알림만 꺼진다
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64=
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=
