# architecture.md 9.5 — 모든 비밀값은 환경 변수로 주입한다. .env는 커밋하지 않는다.
# 이 파일을 .env로 복사해 로컬 값을 채운다.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=ear
DB_PASSWORD=change-me
DB_NAME=runtime

# 쉼표로 구분한 허용 오리진 목록. `*`를 쓰지 않는다.
CORS_ORIGINS=http://localhost:8081

# 서명 키·pepper — 32자 이상. 운영 값은 시크릿 매니저에서 주입한다(domain.md 11.2, architecture.md 9.5).
# ARCHIVE_HASH_PEPPER와 WITHDRAWAL_HASH_PEPPER는 반드시 서로 다른 값이어야 한다.
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
ARCHIVE_HASH_PEPPER=local-dev-archive-pepper-change-me-0123456789
WITHDRAWAL_HASH_PEPPER=local-dev-withdrawal-pepper-change-me-0123456789

# 애플 로그인 — identity token의 aud로 실려 오는 iOS 앱 Bundle ID다(auth-api.md 4.1).
# 비밀값은 아니지만 검증에 반드시 필요하다. 확인하지 않으면 다른 앱을 향해 발급된,
# 서명은 정상인 토큰으로 우리 계정에 로그인할 수 있다.
# 애플은 제공자 API 호출 없이 토큰만으로 검증이 끝나므로 aud가 사실상 유일한 판정 근거다.
APPLE_CLIENT_ID=com.example.ear

# 구글 로그인 — ID 토큰의 aud로 실려 오는 웹 클라이언트 ID다(auth-api.md 4.1).
# 안드로이드/iOS 클라이언트 ID가 아니다. 클라이언트가 액세스 토큰이 아니라 ID 토큰을 보내므로
# 서버는 제공자 API 왕복 없이 서명과 aud만으로 검증한다 — aud가 유일한 "우리 앱을 향한
# 토큰인가" 판정 근거다.
GOOGLE_WEB_CLIENT_ID=475643832949-q10v2jk03pjh0f37vurot61c216snist.apps.googleusercontent.com

# 카카오 로그인 — 토큰 정보 조회의 app_id와 대조할 앱 ID(숫자)다. 네이티브 앱 키가 아니다.
# 카카오 액세스 토큰에는 대상 앱 정보가 실려 있지 않아, 이 대조가 없으면 다른 카카오 앱에서
# 발급된 정상 토큰으로도 우리 계정에 로그인할 수 있다(auth-api.md 4.1).
KAKAO_APP_ID=1533429

# 앱 버전 — 테이블이 아니라 배포 설정이 원천이다(settings-api.md 4.1, domain.md 13.3).
# LATEST_APP_VERSION_*: 스토어 최신 버전. 설정 화면의 [업데이트] 배지 판정에 쓴다.
# MIN_SUPPORTED_APP_VERSION_*: 최소 지원 버전. 강제 업데이트 판정은 스플래시 소관이다.
#
# 플랫폼별로 나눈다 — 스토어 심사 주기가 달라 두 값이 동시에 올라가지 않는다.
# 한쪽만 배포된 동안에는 그쪽 값만 올린다. 둘을 함께 올리면 아직 심사 중인 플랫폼의
# 사용자에게 받을 것이 없는 [업데이트]가 뜨고, 최소 지원까지 올리면 그 사용자가 갇힌다.
LATEST_APP_VERSION_IOS=1.0.0
LATEST_APP_VERSION_ANDROID=1.0.0
MIN_SUPPORTED_APP_VERSION_IOS=1.0.0
MIN_SUPPORTED_APP_VERSION_ANDROID=1.0.0

# 오디오 서명 URL — architecture.md 9.4. 우리 서버가 서명하고 우리 서버가 검증한다.
# AUDIO_URL_SIGNING_KEY: 32자 이상. JWT_SECRET과 반드시 다른 값이어야 한다.
# AUDIO_URL_BASE_URL: 서명 URL이 가리키는 스트리밍 경로. 오브젝트 스토리지 확정 시 CDN 도메인으로 바뀐다.
AUDIO_URL_SIGNING_KEY=local-dev-audio-signing-key-change-me-0123456789
AUDIO_URL_BASE_URL=http://localhost:3000/api/v1/audio
# AUDIO_STORAGE_ROOT: 오디오 원본 디렉터리. contents.audio_path가 이 아래의 상대 키다.
AUDIO_STORAGE_ROOT=./storage/audio

# 신뢰하는 리버스 프록시(LB) 홉 수 — 기본 0(끔). LB 뒤에 배포할 때만 홉 수만큼 올린다.
# 프록시가 없는데 켜면 X-Forwarded-For로 IP를 위조할 수 있다 — 켜는 쪽이 더 위험하다.
TRUST_PROXY_HOPS=0
